rules_version = '2';

// TransitFlow — multi-company access rules.
//
// Two things changed from the single-company original:
//
// 1. Every company's data lives under `tenants/{tenantId}/…`, and the company a
//    request may touch comes from the `tenant` claim on the caller's token. A
//    request whose path does not match its claim is refused, so isolation does
//    not depend on any query remembering to filter.
//
// 2. The role is read from the token too, not looked up with `get()`. The old
//    rules fetched `users/{uid}` on *every* request — a document read charged
//    and awaited each time. Claims are already in the token, so role checks now
//    cost nothing.
//
// Claims are set server-side when an account is provisioned. A user cannot
// change their own claims, so they cannot move themselves to another company or
// promote themselves.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Claims ----
    function signedIn() {
      return request.auth != null;
    }
    function tenant() {
      return request.auth.token.tenant;
    }
    function role() {
      return request.auth.token.role;
    }
    function inTenant(tenantId) {
      return signedIn() && tenant() == tenantId;
    }
    function isAdmin(tenantId) {
      return inTenant(tenantId) && role() == 'admin';
    }
    // Write-capable variants: the same role, plus a company in good standing.
    function canAdmin(tenantId) {
      return isAdmin(tenantId) && companyActive(tenantId);
    }
    function isStaff(tenantId) {
      return inTenant(tenantId) && (role() == 'admin' || role() == 'moderator');
    }
    function canStaff(tenantId) {
      return isStaff(tenantId) && companyActive(tenantId);
    }
    function isInspector(tenantId) {
      return inTenant(tenantId) && role() == 'inspector';
    }
    function canInspect(tenantId) {
      return isInspector(tenantId) && companyActive(tenantId);
    }
    // A bus terminal. Signs in anonymously and is enrolled to a company by an
    // admin, which is what puts the tenant claim on its token. Drivers never
    // type credentials — the device carries the identity.
    function isDevice(tenantId) {
      return inTenant(tenantId) && role() == 'device';
    }
    function canDevice(tenantId) {
      return isDevice(tenantId) && companyActive(tenantId);
    }
    // Anyone the company has issued a token to: staff, inspector or terminal.
    function belongs(tenantId) {
      return inTenant(tenantId);
    }
    function canWrite(tenantId) {
      return inTenant(tenantId) && companyActive(tenantId);
    }
    // The platform owner administers the companies but is not a member of any.
    // They may see which companies exist and how much each one uses the system —
    // never the passengers' personal data, which belongs to the operator.
    function isPlatformOwner() {
      return signedIn() && request.auth.token.platformAdmin == true;
    }

    // A company suspended for non-payment may still see its data but may not
    // change anything. This costs one document read, so it guards writes only —
    // reads stay free, and a frozen company is one that cannot operate, not one
    // that cannot look.
    function companyActive(tenantId) {
      return get(/databases/$(database)/documents/tenants/$(tenantId)).data.active != false;
    }

    // Writes must stamp the document with the company they belong to, and may
    // never claim a different one. This is what makes collection-group queries
    // safe: a document that lies about its tenant cannot be written.
    function stampedCorrectly(tenantId) {
      return request.resource.data.tenant == tenantId;
    }

    // ---- Company registry ----
    // Readable by that company's own users (name, logo, colours, enabled
    // modules). Only the platform, through the Admin SDK, may write it.
    match /tenants/{tenantId} {
      allow get: if belongs(tenantId) || isPlatformOwner();
      allow list: if isPlatformOwner();
      allow write: if false;

      // ---- Staff accounts ----
      // Everyone in the company can see the staff list (emails and roles only).
      // Accounts are created and removed by the provisioning Cloud Function,
      // which uses the Admin SDK and bypasses these rules. A user may update
      // only their own `lastSeen` stamp.
      match /users/{userId} {
        allow read: if belongs(tenantId);
        allow create, delete: if false;
        allow update: if canAdmin(tenantId)
          || (canWrite(tenantId) && request.auth.uid == userId
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeen']));
      }

      // ---- Cards ----
      // A single card is readable by any device or user enrolled to this
      // company — that is what happens when a card is tapped on a bus. Listing
      // the whole collection, issuing and editing cards require staff.
      // Permanent deletion requires an admin.
      match /clients/{clientId} {
        allow get: if belongs(tenantId);
        allow list: if isStaff(tenantId) || isInspector(tenantId);
        // A chip may stand behind one card and no other. The map of chip to card
        // is written by a Cloud Function and readable here, so activation with a
        // chip that already belongs to somebody is refused at the door rather
        // than left to be noticed later.
        allow create: if canStaff(tenantId) && stampedCorrectly(tenantId)
          && (
               !('nfcUid' in request.resource.data)
               || request.resource.data.nfcUid == ''
               || !exists(/databases/$(database)/documents/tenants/$(tenantId)/nfc_uids/$(request.resource.data.nfcUid))
             );
        // Staff may edit anything. A terminal may bump only the scan counters —
        // never the route, expiry, name or photo.
        allow update: if canStaff(tenantId)
          || (canDevice(tenantId)
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['scanCount', 'lastScanAt', 'lastScanCounter', 'nfcUid',
                             'dailyScanCount', 'lastScanDate', 'scanHistory']));
        allow delete: if canAdmin(tenantId);

        match /scans/{scanId} {
          allow read: if isStaff(tenantId);
          // A bus terminal records a validation without being signed in, the way
          // drivers actually work. The shape is pinned so the collection cannot
          // be stuffed with arbitrary documents, and the tenant must match the
          // path it is being written into.
          //
          // The three staff markers are what tells a boarding apart from a card
          // opened at the desk, and a scan carrying them is left out of the
          // unpaid-travel report. So they may only be written by someone who
          // actually is staff, and only naming the role their own token carries
          // — otherwise an anonymous terminal could stamp every boarding as desk
          // work and empty the report from the bus.
          allow create: if stampedCorrectly(tenantId)
            && request.resource.data.at is string
            && request.resource.data.keys().hasOnly(
                 ['at', 'route', 'tenant', 'scannedBy', 'scannedByName', 'role'])
            && (
                 !request.resource.data.keys().hasAny(['scannedBy', 'scannedByName', 'role'])
                 || ((isStaff(tenantId) || isInspector(tenantId))
                     && request.resource.data.role == role())
               );
          allow update, delete: if canAdmin(tenantId);
        }
      }

      // ---- The company's own configuration ----
      // Its lines, stops and fares. Everyone in the company reads them (the
      // panels price against them); only an admin changes them.
      match /routes/{routeId} {
        // A fare table is a published tariff — it hangs in the bus and at the
        // stop. A passenger reading their own card is signed in to nothing, and
        // needs it to see what their subscription costs, so reading is open.
        // Nothing here is personal: line names, stops and prices only.
        allow read: if true;
        allow write: if canAdmin(tenantId);
      }
      match /service_rosters/{rosterId} {
        // The official list of people entitled to a free service card. Staff
        // check cards against it; only an admin writes it.
        allow read: if belongs(tenantId);
        allow write: if canAdmin(tenantId);
      }

      match /settings/{docId} {
        allow read: if belongs(tenantId);
        allow write: if canAdmin(tenantId);
      }

      // ---- The passenger's own card ----
      // Readable by anyone holding the code, which exists only on the physical
      // card — that is what a passenger tapping their card has, and it is why
      // this works without an account. Listing is refused, so the collection
      // cannot be walked; a code has to be known, and it cannot be guessed.
      // Written only by syncPublicCard, from the fields the card face shows.
      match /public_cards/{code} {
        allow get: if true;
        allow list, write: if false;
      }

      // ---- Card stock ----
      // The blank cards this company has had minted. Written only by the
      // generateCardBatch function, so a code cannot be added by hand and then
      // registered to somebody.
      match /card_stock/{code} {
        allow read: if belongs(tenantId);
        allow write: if false;
      }
      match /counters/{counterId} {
        allow read: if canStaff(tenantId);
        allow write: if false;
      }

      // ---- Physical chip UID -> card ----
      // Lets a terminal that read only the chip's UID resolve it to a card.
      // Written by the syncNfcUid Cloud Function.
      match /nfc_uids/{uid} {
        allow get: if belongs(tenantId);
        allow list: if isStaff(tenantId);
        allow write: if false;
      }

      // ---- Passenger intake forms (optional modules) ----
      // Anyone the company has issued a token to may submit; staff manage them.
      // Whether the module is usable at all is decided by the company's record,
      // which only the platform can write.
      match /signals/{signalId} {
        allow create: if canWrite(tenantId) && stampedCorrectly(tenantId);
        allow read, update, delete: if isStaff(tenantId);
      }
      match /rentals/{rentalId} {
        allow create: if canWrite(tenantId) && stampedCorrectly(tenantId);
        allow read, update, delete: if isStaff(tenantId);
      }

      // ---- Notifications ----
      match /push_subscriptions/{subId} {
        allow read: if belongs(tenantId);
        allow create, delete: if canWrite(tenantId);
        allow update: if canStaff(tenantId);
      }
      match /push_notifications/{notifId} {
        allow read: if belongs(tenantId);
        allow create: if canStaff(tenantId) && stampedCorrectly(tenantId);
        allow update, delete: if canAdmin(tenantId);
      }
      match /admin_push_tokens/{tokenId} {
        allow read: if isStaff(tenantId);
        allow create, delete, update: if canStaff(tenantId);
      }

      // ---- Audit trail ----
      match /activity_logs/{logId} {
        allow read: if isStaff(tenantId);
        allow create: if canStaff(tenantId) && stampedCorrectly(tenantId);
        allow update, delete: if canAdmin(tenantId);
      }

      // ---- Security monitoring ----
      // Written only by the reportFailedLogin Cloud Function.
      match /login_attempts/{attemptId} {
        allow read: if isStaff(tenantId);
        allow write: if false;
      }
      match /login_attempt_counters/{counterId} {
        allow read, write: if false;
      }

      // ---- Duplicate-card alerts ----
      // A terminal raises one when a chip UID does not match the card on file.
      match /clone_alerts/{alertId} {
        allow create: if canWrite(tenantId) && stampedCorrectly(tenantId);
        allow read, delete: if isStaff(tenantId);
        allow update: if canAdmin(tenantId);
      }

      // ---- Terminal hand-shake ----
      // Holds a transient card id while a card is being registered at the desk.
      match /admin_actions/{actionId} {
        allow read: if belongs(tenantId);
        allow write: if canWrite(tenantId);
      }

      // ---- Inspections ----
      // An inspector sees only their own checks; admins see all.
      match /inspector_scans/{scanId} {
        allow create: if (canInspect(tenantId) || canAdmin(tenantId)) && stampedCorrectly(tenantId);
        allow read: if isAdmin(tenantId)
          || (isInspector(tenantId) && resource.data.inspectorId == request.auth.uid);
        allow update, delete: if canAdmin(tenantId);
      }
      match /inspector_reports/{reportId} {
        allow create: if (canInspect(tenantId) || canAdmin(tenantId)) && stampedCorrectly(tenantId);
        allow read: if isAdmin(tenantId)
          || (isInspector(tenantId) && resource.data.inspectorId == request.auth.uid);
        allow update, delete: if canAdmin(tenantId);
      }

      // ---- Fines ----
      // Standalone charges (a lost-card fee) kept apart from renewals so they
      // count toward revenue without extending a subscription.
      match /fines/{fineId} {
        allow read: if isStaff(tenantId);
        allow create: if canStaff(tenantId) && stampedCorrectly(tenantId);
        allow update, delete: if canAdmin(tenantId);
      }

      // ---- Travelling without a subscription ----
      // One small row per boarding that had no paid subscription, written by
      // the alertUnpaidScan function at the moment of the scan. The report reads
      // this instead of every scan in the company. Nothing in the browser writes
      // here: the Admin SDK bypasses these rules, so the function is unaffected
      // by the flat refusal, and a row cannot be forged or quietly edited away.
      match /unpaid_scans/{rowId} {
        allow read: if isStaff(tenantId);
        allow create, update: if false;
        allow delete: if canAdmin(tenantId);
      }

      // ---- Precomputed monthly totals ----
      // Maintained by a Cloud Function so the dashboard reads one document
      // instead of every card in the company.
      match /rollups/{month} {
        allow read: if isStaff(tenantId) || isPlatformOwner();
        allow write: if false;
      }
    }

    // ---- Collection-group reads ----
    // A collection-group query spans the whole database regardless of path, so
    // it is guarded on the document's own tenant field. A query that forgets to
    // filter is denied rather than served another company's rows.
    match /{path=**}/scans/{scanId} {
      allow read: if signedIn() && resource.data.tenant == tenant()
        && (role() == 'admin' || role() == 'moderator');
    }

    // ---- Default deny ----
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
