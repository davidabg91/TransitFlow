rules_version = '2';

// TransitFlow — multi-company access rules.
//
// Two things changed from the single-company original:
//
// 1. Every company's data lives under `tenants/{tenantId}/…`, and the company a
//    request may touch comes from the `tenant` claim on the caller's token. A
//    request whose path does not match its claim is refused, so isolation does
//    not depend on any query remembering to filter.
//
// 2. The role is read from the token too, not looked up with `get()`. The old
//    rules fetched `users/{uid}` on *every* request — a document read charged
//    and awaited each time. Claims are already in the token, so role checks now
//    cost nothing.
//
// Claims are set server-side when an account is provisioned. A user cannot
// change their own claims, so they cannot move themselves to another company or
// promote themselves.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Claims ----
    function signedIn() {
      return request.auth != null;
    }
    function tenant() {
      return request.auth.token.tenant;
    }
    function role() {
      return request.auth.token.role;
    }
    function inTenant(tenantId) {
      return signedIn() && tenant() == tenantId;
    }
    function isAdmin(tenantId) {
      return inTenant(tenantId) && role() == 'admin';
    }
    function isStaff(tenantId) {
      return inTenant(tenantId) && (role() == 'admin' || role() == 'moderator');
    }
    function isInspector(tenantId) {
      return inTenant(tenantId) && role() == 'inspector';
    }
    // A bus terminal. Signs in anonymously and is enrolled to a company by an
    // admin, which is what puts the tenant claim on its token. Drivers never
    // type credentials — the device carries the identity.
    function isDevice(tenantId) {
      return inTenant(tenantId) && role() == 'device';
    }
    // Anyone the company has issued a token to: staff, inspector or terminal.
    function belongs(tenantId) {
      return inTenant(tenantId);
    }
    // The platform owner administers the companies but is not a member of any.
    // They may see which companies exist and how much each one uses the system —
    // never the passengers' personal data, which belongs to the operator.
    function isPlatformOwner() {
      return signedIn() && request.auth.token.platformAdmin == true;
    }

    // Writes must stamp the document with the company they belong to, and may
    // never claim a different one. This is what makes collection-group queries
    // safe: a document that lies about its tenant cannot be written.
    function stampedCorrectly(tenantId) {
      return request.resource.data.tenant == tenantId;
    }

    // ---- Company registry ----
    // Readable by that company's own users (name, logo, colours, enabled
    // modules). Only the platform, through the Admin SDK, may write it.
    match /tenants/{tenantId} {
      allow get: if belongs(tenantId) || isPlatformOwner();
      allow list: if isPlatformOwner();
      allow write: if false;

      // ---- Staff accounts ----
      // Everyone in the company can see the staff list (emails and roles only).
      // Accounts are created and removed by the provisioning Cloud Function,
      // which uses the Admin SDK and bypasses these rules. A user may update
      // only their own `lastSeen` stamp.
      match /users/{userId} {
        allow read: if belongs(tenantId);
        allow create, delete: if false;
        allow update: if isAdmin(tenantId)
          || (belongs(tenantId) && request.auth.uid == userId
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeen']));
      }

      // ---- Cards ----
      // A single card is readable by any device or user enrolled to this
      // company — that is what happens when a card is tapped on a bus. Listing
      // the whole collection, issuing and editing cards require staff.
      // Permanent deletion requires an admin.
      match /clients/{clientId} {
        allow get: if belongs(tenantId);
        allow list: if isStaff(tenantId) || isInspector(tenantId);
        allow create: if isStaff(tenantId) && stampedCorrectly(tenantId);
        // Staff may edit anything. A terminal may bump only the scan counters —
        // never the route, expiry, name or photo.
        allow update: if isStaff(tenantId)
          || (isDevice(tenantId)
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['scanCount', 'lastScanAt', 'lastScanCounter', 'nfcUid',
                             'dailyScanCount', 'lastScanDate', 'scanHistory']));
        allow delete: if isAdmin(tenantId);

        match /scans/{scanId} {
          allow read: if isStaff(tenantId);
          allow create: if belongs(tenantId) && stampedCorrectly(tenantId);
          allow update, delete: if isAdmin(tenantId);
        }
      }

      // ---- Physical chip UID -> card ----
      // Lets a terminal that read only the chip's UID resolve it to a card.
      // Written by the syncNfcUid Cloud Function.
      match /nfc_uids/{uid} {
        allow get: if belongs(tenantId);
        allow list: if isStaff(tenantId);
        allow write: if false;
      }

      // ---- Notifications ----
      match /push_subscriptions/{subId} {
        allow read, create, delete: if belongs(tenantId);
        allow update: if isStaff(tenantId);
      }
      match /push_notifications/{notifId} {
        allow read: if belongs(tenantId);
        allow create: if isStaff(tenantId) && stampedCorrectly(tenantId);
        allow update, delete: if isAdmin(tenantId);
      }
      match /admin_push_tokens/{tokenId} {
        allow read, create, delete, update: if isStaff(tenantId);
      }

      // ---- Audit trail ----
      match /activity_logs/{logId} {
        allow read: if isStaff(tenantId);
        allow create: if isStaff(tenantId) && stampedCorrectly(tenantId);
        allow update, delete: if isAdmin(tenantId);
      }

      // ---- Security monitoring ----
      // Written only by the reportFailedLogin Cloud Function.
      match /login_attempts/{attemptId} {
        allow read: if isStaff(tenantId);
        allow write: if false;
      }
      match /login_attempt_counters/{counterId} {
        allow read, write: if false;
      }

      // ---- Duplicate-card alerts ----
      // A terminal raises one when a chip UID does not match the card on file.
      match /clone_alerts/{alertId} {
        allow create: if belongs(tenantId) && stampedCorrectly(tenantId);
        allow read, delete: if isStaff(tenantId);
        allow update: if isAdmin(tenantId);
      }

      // ---- Terminal hand-shake ----
      // Holds a transient card id while a card is being registered at the desk.
      match /admin_actions/{actionId} {
        allow read, write: if belongs(tenantId);
      }

      // ---- Inspections ----
      // An inspector sees only their own checks; admins see all.
      match /inspector_scans/{scanId} {
        allow create: if (isInspector(tenantId) || isAdmin(tenantId)) && stampedCorrectly(tenantId);
        allow read: if isAdmin(tenantId)
          || (isInspector(tenantId) && resource.data.inspectorId == request.auth.uid);
        allow update, delete: if isAdmin(tenantId);
      }
      match /inspector_reports/{reportId} {
        allow create: if (isInspector(tenantId) || isAdmin(tenantId)) && stampedCorrectly(tenantId);
        allow read: if isAdmin(tenantId)
          || (isInspector(tenantId) && resource.data.inspectorId == request.auth.uid);
        allow update, delete: if isAdmin(tenantId);
      }

      // ---- Fines ----
      // Standalone charges (a lost-card fee) kept apart from renewals so they
      // count toward revenue without extending a subscription.
      match /fines/{fineId} {
        allow read, create: if isStaff(tenantId) && stampedCorrectly(tenantId);
        allow update, delete: if isAdmin(tenantId);
      }

      // ---- Precomputed monthly totals ----
      // Maintained by a Cloud Function so the dashboard reads one document
      // instead of every card in the company.
      match /rollups/{month} {
        allow read: if isStaff(tenantId) || isPlatformOwner();
        allow write: if false;
      }
    }

    // ---- Collection-group reads ----
    // A collection-group query spans the whole database regardless of path, so
    // it is guarded on the document's own tenant field. A query that forgets to
    // filter is denied rather than served another company's rows.
    match /{path=**}/scans/{scanId} {
      allow read: if signedIn() && resource.data.tenant == tenant()
        && (role() == 'admin' || role() == 'moderator');
    }

    // ---- Default deny ----
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
