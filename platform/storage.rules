rules_version = '2';

// Card photos, one folder per company.
//
// Like the Firestore rules, these read the company and the role straight from
// the token's claims. The original looked each user up in Firestore on every
// single file request, which cost a document read and a round trip per photo.

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }
    function inTenant(tenantId) {
      return signedIn() && request.auth.token.tenant == tenantId;
    }
    function isStaff(tenantId) {
      return inTenant(tenantId)
        && (request.auth.token.role == 'admin' || request.auth.token.role == 'moderator');
    }

    // A photo is readable by anyone enrolled to that company — staff at the
    // desk, an inspector on the bus, or the terminal showing the card on screen.
    // Only staff may upload, and only reasonably sized images.
    match /tenants/{tenantId}/client_photos/{file} {
      allow read: if inTenant(tenantId);
      allow write: if isStaff(tenantId)
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // The company's logo, printed at the top of its registers and reports.
    // Everyone in the company sees it; only an admin replaces it. Kept small —
    // it is scaled down in the browser before it is ever sent.
    match /tenants/{tenantId}/branding/{file} {
      allow read: if inTenant(tenantId);
      allow write: if inTenant(tenantId)
        && request.auth.token.role == 'admin'
        && request.resource.size < 1 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Everything else is locked down.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
